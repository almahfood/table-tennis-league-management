# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============= Database Configuration =============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=table_tennis_league
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/table_tennis_league

# ============= Flask Configuration =============
SECRET_KEY=your-super-secret-key-change-this
DEBUG=False
FLASK_ENV=production
FLASK_APP=app.py

# ============= JWT Configuration =============
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ============= Redis Cache Configuration =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ============= Email Configuration =============
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@table-tennis-bh.org

# ============= Application URLs =============
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api
DOMAIN=table-tennis-bh.org

# ============= Pagination =============
ITEMS_PER_PAGE=20
MAX_PAGINATION_LIMIT=100

# ============= File Upload =============
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,gif

# ============= Timezone =============
TIMEZONE=Asia/Bahrain

# ============= Logging =============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ============= CORS Configuration =============
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://table-tennis-bh.org

# ============= Session Configuration =============
SESSION_TIMEOUT=1800
PERMANENT_SESSION_LIFETIME=1800

# ============= API Rate Limiting =============
RATELIMIT_ENABLED=True
RATELIMIT_REQUESTS=100
RATELIMIT_PERIOD=60

# ============= Security =============
BCRYPT_LOG_ROUNDS=12
SECURE_COOKIES=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ============= AWS S3 (Optional) =============
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ============= Features =============
ENABLE_NOTIFICATIONS=True
ENABLE_EMAIL_VERIFICATION=True
ENABLE_TWO_FACTOR_AUTH=False

# ============= Admin Account =============
ADMIN_EMAIL=admin@table-tennis-bh.org
ADMIN_PASSWORD=change-this-password

# ============= Sentry (Error Tracking - Optional) =============
SENTRY_DSN=

# ============= API Keys =============
SECRET_API_KEY=your-secret-api-key
